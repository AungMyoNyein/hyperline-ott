# Application-only deployment. Existing CDN/origin and VPN services are untouched.
APP_URL=https://api.zentunnel.net
NEXT_PUBLIC_API_URL=https://api.zentunnel.net/api/v1
OTT_SIGNED_URLS=true
OTT_PLAYBACK_SIGNER=App\Support\Playback\ExistingCdnPlaybackSigner
# Keep false: existing CDN's documented signing protocol is not yet confirmed.
OTT_EXISTING_CDN_VERIFIED=false
# Implement ExistingCdnAuthorizer using ONLY the real operator's protocol.
# No signing credentials or algorithm are invented or enabled by this template.
OTT_EXISTING_CDN_AUTHORIZER=
OTT_PLAYBACK_TTL_SECONDS=900
OTT_PLAYBACK_MAX_SESSION_SECONDS=14400
# Historical same-site cookie experiment is disabled and not required.
OTT_NGINX_CDN_VERIFIED=false
CORS_ALLOWED_ORIGINS=https://ott.zentunnel.net,https://cms.zentunnel.net
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=api.zentunnel.net

# Queue visibility timeout exceeds the worker execution timeout (90s).
REDIS_QUEUE_RETRY_AFTER=150
