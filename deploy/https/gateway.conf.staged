# OPTIONAL STAGING ONLY. Do NOT edit the live-mounted infra file without approval.
# WebSocket Upgrade support must exist on BOTH proxy hops. Production Next.js
# currently has no verified WS endpoint; this is not required for basic HTTPS.
map $http_upgrade $hyperline_gateway_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name ott.zentunnel.net;
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hyperline_gateway_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
server {
    listen 80;
    server_name cms.zentunnel.net;
    location / {
        proxy_pass http://cms:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hyperline_gateway_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
server {
    listen 80;
    server_name api.zentunnel.net;
    root /var/www/html/public;
    index index.php;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 120s;
        fastcgi_pass api:9000;
    }
    location ~ /\. { deny all; }
}
