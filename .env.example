APP_NAME="HyperLine OTT"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.zentunnel.net
APP_KEY=
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hyperline
DB_USERNAME=hyperline
DB_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_DB=hyperline
POSTGRES_USER=hyperline
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CORS_ALLOWED_ORIGINS=https://ott.zentunnel.net,https://cms.zentunnel.net
NEXT_PUBLIC_API_URL=https://api.zentunnel.net/api/v1
HYPERLINE_INITIAL_ADMIN_PASSWORD=

# Production playback requires a CDN-specific signer implementation.
OTT_SIGNED_URLS=true
OTT_PLAYBACK_SIGNER=App\Support\Playback\ExistingCdnPlaybackSigner

# Existing CDN only; keep gated until its real access protocol is configured.
OTT_EXISTING_CDN_VERIFIED=false
OTT_EXISTING_CDN_AUTHORIZER=

# Queue visibility timeout exceeds the worker execution timeout (90s).
REDIS_QUEUE_RETRY_AFTER=150

# Exact frontend origins are required; never use wildcard credentialed CORS.
CORS_SUPPORTS_CREDENTIALS=true

# Absolute bearer-token lifetime in minutes; minimum 1 (1440 = 24 hours).
# Absolute token lifetime in minutes, clamped to 1–10080 (7 days).
SANCTUM_TOKEN_EXPIRATION=1440
